#include <iostream>
#include <queue>
#include <vector>
using namespace std;

int main()
{
    int N, K;
    vector<int> v;

    cin >> N >> K;

    for (int i = 0; i < N; i++)
    {
        int num;
        cin >> num;
        v.push_back(num);
    }

    priority_queue<int, vector<int>, greater<int>> pq(v.begin(), v.end());

    for (int i = 0; i < K - 1; i++)
    {
        pq.pop();
    }

    cout << pq.top() << endl;

    return 0;
}
